{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node CLI, not a Worker: swap the workers-types global for @types/node
    // and pull in DOM lib for the React report components.
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
